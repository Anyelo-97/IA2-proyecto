# ==========================================
# Archivo de Ejemplo de Variables de Entorno
# ==========================================
# Instrucciones:
# 1. Haz una copia de este archivo y renómbralo a '.env'.
# 2. Reemplaza los valores de ejemplo por tus credenciales reales.
# ATENCIÓN: El archivo '.env' real nunca debe ser subido al repositorio.

# ------------------------------------------
# Configuración de Base de Datos (MySQL/PostgreSQL)
# ------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/rutaIA
DB_USER=tu_usuario_de_db
DB_PASSWORD=tu_contraseña_secreta
SQL_INIT_MODE=never
ADMIN_REGISTRATION_CODE=define_un_codigo_secreto

# ------------------------------------------
# URLs de Webhooks de n8n
# ------------------------------------------
# URL para el flujo de sincronización de cursos (Crear/Actualizar/Desactivar)
N8N_SYNC_URL=https://tu-ngrok-o-dominio.ngrok-free.dev/webhook/curso-sync
# URL para el flujo principal de RAG (Consultas de estudiantes)
N8N_QUERY_URL=https://tu-ngrok-o-dominio.ngrok-free.dev/webhook/rag-query

# ------------------------------------------
# Seguridad y Autenticación
# ------------------------------------------
# Secreto compartido entre Spring Boot y n8n (Header: X-Webhook-Secret)
N8N_WEBHOOK_SECRET=un_secreto_largo_y_seguro_para_n8n
# Llave secreta para la generación y validación de tokens JWT (Fase 2)
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_256_bits_de_longitud_para_hs256
JWT_EXPIRATION_MS=86400000
# Código de autorización requerido para registrar usuarios administradores
ADMIN_REGISTRATION_CODE=tu_codigo_secreto_para_crear_admin

# ------------------------------------------
# Configuración Web (CORS)
# ------------------------------------------
# Orígenes permitidos (URL de tu frontend HTML/JS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5500

# ------------------------------------------
# Integraciones de Inteligencia Artificial (Solo Informativo)
# ------------------------------------------
# Esta clave NO va en el backend de Java, se debe configurar manualmente 
# dentro de los nodos HTTP (Header Auth) de OpenRouter en n8n.
OPENROUTER_API_KEY=sk-or-v1-tu-clave-de-openrouter-aqui
