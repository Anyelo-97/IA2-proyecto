    {
      "parameters": {
        "jsCode": "const b = $json.body ?? $json;\nconst consultaId = b.consultaId ?? 'consulta-temp';\nconst pregunta1 = (b.pregunta1 ?? b.mensaje ?? '').trim();\nconst pregunta2 = (b.pregunta2 ?? b.mensaje ?? '').trim();\n\n\n\n// Filtro determinista en Qdrant: solo cursos activos\nconst filter = {\n  must: [\n    {\n      key: 'estado',\n      match: { value: true }\n    }\n  ]\n};\n\nreturn [{\n  json: {\n    consultaId,\n    pregunta1,\n    pregunta2,\n    filter,\n    qdrant_url: 'http://qdrant:6333',\n    coleccion: 'cursos',\n    modelo_embedding: 'text-embedding-3-small',\n    limite: 5,\n    score_threshold: 0.45\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
