    },
    {
      "parameters": {
        "jsCode": "const punto_1 = $input.first().json.categoria1;\n\nconst punto_2 = $input.first().json.categoria2 ;\n\nif (punto_1 === punto_2) {\n  return [{\n  json: {\n    pregunta_1:$('Prepara Config & Filtros1').first().json.pregunta1,\n    resultado1:$('Buscar en Qdrant1').first().json.result[0].payload.nombre,\n    coseno1:$('Buscar en Qdrant1').first().json.result[0].score,\n    pregunta_2: $('Prepara Config & Filtros1').first().json.pregunta2,\n    resultado2:$('Buscar en Qdrant2').first().json.result[0].payload.nombre,\n    coseno2:$('Buscar en Qdrant2').first().json.result[0].score,\n    texto: \"Al buscar con los embeddings, se refiere a los temas mas cercanos creados por los puntos en el qdrant. asi que aunque tenga palabras diferentes, los puntos de qdrant busca los mas parecidos\"\n    \n  }\n}];\n}"
      },
